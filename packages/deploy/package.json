{
  "name": "@yunlefun/deploy",
  "type": "module",
  "version": "0.0.12",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunLeFun/ylf.git",
    "directory": "packages/deploy"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "deploy": "./bin/index.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "prepublishOnly": "npm run build",
    "release": "pnpm publish",
    "release:local": "pnpm publish",
    "test": "cd test && pnpm exec deploy"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.66.1",
    "axios": "^1.18.0",
    "c12": "^2.0.1",
    "cloudflare": "^3.5.0",
    "consola": "^3.2.3",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "execa": "^9.5.1",
    "fs-extra": "^11.2.0",
    "gradient-string": "^3.0.0",
    "tencentcloud-sdk-nodejs": "^4.0.970"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/gradient-string": "^1.1.6",
    "cilicili": "workspace:*",
    "unbuild": "^2.0.0"
  }
}
