{
  "name": "@yunlefun/sso",
  "type": "module",
  "version": "0.6.2",
  "description": "云乐坊（Yunle.fun）跨站 SSO：一处登录、各站免登的客户端与协议层",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunLeFun/ylf.git",
    "directory": "packages/sso"
  },
  "keywords": [
    "sso",
    "single-sign-on",
    "cloudbase",
    "yunlefun"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.mjs",
      "require": "./dist/protocol.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "unbuild": "^2.0.0"
  }
}
